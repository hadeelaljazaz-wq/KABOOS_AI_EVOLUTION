# Copy to .env and fill in what you have. Nothing here is required to run
# collective_memory/ or discovery_lab/ — only the vendored TradingAgents
# agent graph (vendor_tradingagents/) needs an LLM key to actually think.

# Pick ONE provider for vendor_tradingagents and set its key:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional, only used by vendor_tradingagents' macro_data vendor (FRED):
FRED_API_KEY=

# Which provider/models vendor_tradingagents should use (see
# vendor_tradingagents/tradingagents/default_config.py for all knobs):
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
